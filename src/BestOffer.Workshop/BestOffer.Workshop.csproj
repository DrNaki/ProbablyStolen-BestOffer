<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BestOffer</AssemblyName>
    <Version>1.7.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">E:\Steam\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)\*.dll" Exclude="$(ManagedDir)\System*.dll;$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\Mono.Security.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
